{
  "repo_root": "../..",
  "phase_root": "data/semantic_alignment",
  "tokenizer_path": "models/Qwen3-1.7B-Base-Char",
  "seed": 20260714,
  "tolerance": 0.05,
  "normalized_shard_records": 100000,
  "deduplicated_shard_records": 100000,
  "final_shard_tokens": 100000000,
  "quality": {
    "min_chars": 10,
    "min_printable_ratio": 0.98,
    "mixed_min_hanzi": 20,
    "mixed_min_latin_words": 5,
    "mixed_min_hanzi_ratio": 0.15,
    "mixed_max_hanzi_ratio": 0.85
  },
  "dedup": {
    "near_min_chars": 50,
    "natural_num_perm": 128,
    "natural_band_size": 4,
    "natural_threshold": 0.8,
    "code_num_perm": 256,
    "code_band_size": 4,
    "code_threshold": 0.85,
    "candidate_limit_per_bucket": 2000,
    "decontamination_paths": ["data/validation/*.jsonl"]
  },
  "sources": {
    "clue": {
      "enabled": true,
      "path": "/share/project/wuhaiming/data/dataset/clue",
      "license": "unknown",
      "license_note": "Explicit Phase 1 research exception; the dataset card declares the license as unknown.",
      "allow_unverified_license": true
    },
    "fineweb_chinese": {
      "enabled": true,
      "paths": ["/share/project/wuhaiming/data/dataset/fineweb-edu-chinese-v2.2/4_5/*.parquet"],
      "license": "Apache-2.0",
      "license_note": "The OpenCSG Community License also applies."
    },
    "fineweb_english": {
      "enabled": true,
      "paths": ["/share/project/wuhaiming/data/dataset/fineweb-edu/sample/10BT/*.parquet"],
      "license": "ODC-By-1.0",
      "language_score_min": 0.9
    },
    "external": [
      {
        "name": "phase1_external",
        "paths": ["resources/raw/phase1/collected/**/*.jsonl"],
        "optional": true
      }
    ]
  }
}

