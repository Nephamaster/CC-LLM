dataset_path: clue/clue
output_type: generate_until
training_split: train
validation_split: validation
test_split: null
fewshot_split: train
doc_to_target: !function utils.qa_doc_to_target
process_results: !function utils.process_results_qa
generation_kwargs:
  until:
    - "\n"
  do_sample: false
  temperature: 0.0
  max_gen_toks: 64
metric_list:
  - metric: exact_match
    aggregation: mean
    higher_is_better: true
  - metric: f1
    aggregation: mean
    higher_is_better: true
metadata:
  version: 1.0
